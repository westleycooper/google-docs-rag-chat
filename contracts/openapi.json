  "info": {
    "description": "\nRAG chat over Google Drive and other document sources.\n\n**Retrieval** is hybrid: dense pgvector search and Postgres full-text search are\nfused with Reciprocal Rank Fusion, then reranked (ADR-0004). Every turn streams\nits retrieval trace so a wrong answer can be diagnosed rather than merely\nnoticed (ADR-0009).\n\n**Permissions** are respected during ingestion. A folder that cannot be read is\nskipped *with an audit record* and never fails the run, because a silent skip is\nindistinguishable from an empty folder (ADR-0003).\n",
    "title": "Ragoogle API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/chat": {
      "post": {
        "description": "Answer a question over the corpus, streaming the reasoning as it happens.",
        "operationId": "streamChat",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequestIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "An SSE stream. Frame names: `trace` (a retrieval stage finished), `citations` (the sources, sent before the prose that references them), `delta` (answer text), `finished` (the context budget and any degradation), `error`."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Stream Chat",
        "tags": [
          "chat"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Liveness plus dependency state.\n\nA failing dependency degrades rather than fails: the topology should be able\nto show partial availability, and a binary light cannot distinguish \"the API\nis down\" from \"the API is up but cannot reach Postgres\".",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "observability"
        ]
      }
    },
    "/live": {
      "get": {
        "description": "Process liveness only -- deliberately touches no dependency.\n\nKubernetes and Container Apps restart a pod that fails this. Checking\nPostgres here would restart a healthy API during a database blip, turning a\npartial outage into a total one.",
        "operationId": "getLiveness",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Liveness",
        "tags": [
          "observability"
        ]
      }
    },
    "/models": {
      "get": {
        "description": "Selectable Claude models, with context windows read live.\n\nThe window matters beyond display: the context meter (ADR-0008) is computed\nagainst it, so a stale hard-coded value would make the meter confidently\nwrong.",
        "operationId": "listModels",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ModelOption"
                  },
                  "title": "Response Listmodels",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Models",
        "tags": [
          "models"
        ]
      }
    },
    "/sources": {
      "get": {
        "description": "Every registered source, enabled or not.",
        "operationId": "listSources",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SourceOut"
                  },
                  "title": "Response Listsources",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Sources",
        "tags": [
          "sources"
        ]
      },
      "post": {
        "description": "Register a source.\n\n`credential_ref` points into the KMS-backed store; credential material never\nreaches this endpoint, so a request body in a log is not a disclosure.",
        "operationId": "createSource",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SourceIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Source",
        "tags": [
          "sources"
        ]
      }
    },
    "/sources/{source_id}": {
      "delete": {
        "description": "Remove a source and, by cascade, its documents and chunks.",
        "operationId": "deleteSource",
        "parameters": [
          {
            "in": "path",
            "name": "source_id",
            "required": true,
            "schema": {
              "title": "Source Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Source",
        "tags": [
          "sources"
        ]
      },
      "get": {
        "operationId": "getSource",
        "parameters": [
          {
            "in": "path",
            "name": "source_id",
            "required": true,
            "schema": {
              "title": "Source Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Source",
        "tags": [
          "sources"
        ]
      }
    },
    "/sources/{source_id}/credential": {
      "put": {
        "description": "Store a source's credential, encrypted at rest.\n\nWrite-only by design. There is no GET: a credential that can be read back\nover HTTP is a credential one misconfigured permission away from disclosure,\nand nothing in the product needs to display it.",
        "operationId": "setSourceCredential",
        "parameters": [
          {
            "in": "path",
            "name": "source_id",
            "required": true,
            "schema": {
              "title": "Source Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CredentialIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Set Credential",
        "tags": [
          "sources"
        ]
      }
    },
    "/sources/{source_id}/ingest": {
      "post": {
        "description": "Start a run and return immediately.\n\nRuns take minutes to hours, so the request returns the run record and the\nclient polls `/runs/latest`. Holding the connection open for the duration\nwould fail behind any load balancer with an idle timeout.",
        "operationId": "startIngestion",
        "parameters": [
          {
            "in": "path",
            "name": "source_id",
            "required": true,
            "schema": {
              "title": "Source Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "incremental",
            "required": false,
            "schema": {
              "default": true,
              "title": "Incremental",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Start Ingestion",
        "tags": [
          "sources"
        ]
      }
    },
    "/sources/{source_id}/runs/latest": {
      "get": {
        "description": "The most recent run, including everything it could not read.\n\nThe skip list is the point (ADR-0003): a user needs to see what was excluded\nand why, because a silent skip is indistinguishable from an empty folder.",
        "operationId": "getLatestRun",
        "parameters": [
          {
            "in": "path",
            "name": "source_id",
            "required": true,
            "schema": {
              "title": "Source Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/RunOut"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "Response Getlatestrun"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
