# Ragoogle configuration. Copy to .env and fill in.
#   cp .env.example .env
#
# Every value is read by apps/api/src/ragoogle_api/settings.py with the
# RAGOOGLE_ prefix, so the same image runs in every environment and the
# Terraform modules (ADR-0005) have one contract to satisfy.

# ─── Database ────────────────────────────────────────────────────────────
# One URL serves both the app (asyncpg) and Alembic (psycopg3); the driver is
# normalised at each entry point. Port 5433 avoids colliding with a local
# Postgres install.
RAGOOGLE_DATABASE_URL=postgresql+asyncpg://ragoogle:ragoogle@localhost:5433/ragoogle

# ─── Embeddings (ADR-0002) ───────────────────────────────────────────────
# voyage-3-large at 1024 dims. The dimension must match the deployed pgvector
# column: the API compares them at boot and refuses to serve if they disagree,
# because writing truncated vectors silently is far worse than failing loudly.
# Changing this means re-embedding the whole corpus, not just a restart.
# Get a key: https://dashboard.voyageai.com/
VOYAGE_API_KEY=
RAGOOGLE_VOYAGE_API_KEY=
RAGOOGLE_EMBEDDING_MODEL=voyage-3-large
RAGOOGLE_EMBEDDING_DIMENSIONS=1024

# ─── Claude (chat, tokenising, eval judge) ───────────────────────────────
# Also used by the tokeniser: ADR-0008 refuses character-count estimates for the
# context meter, so token counts come from the count_tokens endpoint.
# Get a key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
RAGOOGLE_ANTHROPIC_API_KEY=
RAGOOGLE_DEFAULT_CHAT_MODEL=claude-opus-5

# ─── Credential encryption (ADR-0003) ────────────────────────────────────
# The data key for Google credentials at rest. Without it the API refuses to
# store or use credentials rather than falling back to plaintext, so ingestion
# will not start. Minimum 32 characters.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# In production this belongs in Key Vault / KMS / Cloud KMS, not in a file.
RAGOOGLE_CREDENTIAL_SECRET=

# ─── Retrieval (ADR-0004) ────────────────────────────────────────────────
# candidate_limit must be >= retrieval_limit: the reranker can only reorder what
# recall surfaced, so a narrow pool caps the whole pipeline.
RAGOOGLE_RETRIEVAL_LIMIT=8
RAGOOGLE_CANDIDATE_LIMIT=50
RAGOOGLE_RRF_K=60
RAGOOGLE_RERANK_ENABLED=true
RAGOOGLE_RERANK_MODEL=rerank-2.5

# ─── Context budget (ADR-0008) ───────────────────────────────────────────
RAGOOGLE_CONTEXT_WINDOW=200000
RAGOOGLE_RESERVED_FOR_RESPONSE=8192

# ─── API ─────────────────────────────────────────────────────────────────
RAGOOGLE_CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:5174
RAGOOGLE_LOG_LEVEL=INFO
# OpenTelemetry collector endpoint. Unset disables export.
RAGOOGLE_OTEL_ENDPOINT=

# ─── Frontend (Vite; must be VITE_ prefixed to reach the browser) ────────
VITE_API_BASE_URL=http://localhost:8000

# ─── Google Drive ────────────────────────────────────────────────────────
# NOT set here. Credentials are stored encrypted via the API
# (PUT /sources/{id}/credential) and referenced by credential_ref, so they never
# sit in a file or an environment variable. See ADR-0003.
#
# Service account + domain-wide delegation: paste the JSON key.
# OAuth: paste {"refresh_token": "...", "client_id": "...", "client_secret": "..."}
